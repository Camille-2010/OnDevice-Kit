{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: 连接手机 + Metro",
      "detail": "打开项目时自动执行：选 adb → 连手机(USB/无线) → adb reverse → 没跑就拉起 Metro",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\connect-device.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
